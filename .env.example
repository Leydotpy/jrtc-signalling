# Development only. The service does not load dotenv files automatically.
# Export these values, or let Compose supply them. Never put credentials here.
JRTC_SIGNALLING_HOST=127.0.0.1
JRTC_SIGNALLING_PORT=8765
JRTC_SIGNALLING_WS_PATH=/ws
JRTC_SIGNALLING_STARTUP_TIMEOUT=10
JRTC_SIGNALLING_SHUTDOWN_TIMEOUT=10
JRTC_SIGNALLING_WS_MAX_SIZE=131072
JRTC_SIGNALLING_WS_MAX_QUEUE=16
JRTC_SIGNALLING_WS_PING_INTERVAL=25
JRTC_SIGNALLING_WS_PING_TIMEOUT=20
JRTC_SIGNALLING_LOG_LEVEL=info
