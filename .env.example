# Development only. The service does not load dotenv files automatically.
# Export these values, or let Compose supply them. Never put credentials here.
JRTC_SIGNALLING_HOST=127.0.0.1
JRTC_SIGNALLING_PORT=8765
JRTC_SIGNALLING_WS_PATH=/ws
JRTC_SIGNALLING_STARTUP_TIMEOUT=10
JRTC_SIGNALLING_SHUTDOWN_TIMEOUT=10
JRTC_SIGNALLING_WS_MAX_SIZE=131072
JRTC_SIGNALLING_WS_MAX_QUEUE=16
JRTC_SIGNALLING_WS_PING_INTERVAL=25
JRTC_SIGNALLING_WS_PING_TIMEOUT=20
JRTC_SIGNALLING_LOG_LEVEL=info

# Optional SG-04 authentication rehearsal; mounted files, never inline secrets.
# JRTC_SIGNALLING_AUTH_CONFIG_FILE=/run/config/auth.json
# JRTC_SIGNALLING_TLS_CERT_FILE=/run/secrets/server-cert.pem
# JRTC_SIGNALLING_TLS_KEY_FILE=/run/secrets/server-key.pem

# Optional SG-06 command plane. Requires the bus extra and a persistent inbox path.
# JRTC_SIGNALLING_BUS_CONFIG_FILE=/run/secrets/gateway-bus.json
# SG-07 isolated runtime; requires the bus config and explicit Django cohort.
# JRTC_SIGNALLING_RUNTIME_CONFIG_FILE=/run/secrets/gateway-runtime.json
# JRTC_SIGNALLING_SHUTDOWN_TIMEOUT=30
