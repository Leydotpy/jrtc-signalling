{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jrtc-signalling:v1:response",
  "title": "response",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "ok": {
      "type": "boolean"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "server_time": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    },
    "result": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "action": {
              "enum": [
                "join_and_configure",
                "publish",
                "configure",
                "unpublish",
                "join",
                "update",
                "start",
                "trickle",
                "noop",
                "detach",
                "hangup",
                "ice_restart"
              ]
            },
            "participant_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            "handle_type": {
              "enum": [
                "publisher",
                "subscriber"
              ]
            },
            "lifecycle_state": {
              "enum": [
                "attaching",
                "attached",
                "joining",
                "ready",
                "detaching",
                "detached",
                "failed"
              ]
            },
            "jsep": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "enum": [
                        "offer",
                        "answer"
                      ]
                    },
                    "sdp": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 65536
                    }
                  },
                  "required": [
                    "type",
                    "sdp"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "streams": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                  },
                  "direction": {
                    "enum": [
                      "inbound",
                      "outbound"
                    ]
                  },
                  "media_kind": {
                    "enum": [
                      "audio",
                      "video",
                      "screen",
                      "data"
                    ]
                  },
                  "janus_mid": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 128
                  },
                  "janus_feed_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[1-9][0-9]*$",
                        "maxLength": 128
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "janus_feed_mid": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 128
                  },
                  "codec": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 128
                  },
                  "is_active": {
                    "type": "boolean"
                  },
                  "is_ready": {
                    "type": "boolean"
                  },
                  "is_moderated": {
                    "type": "boolean"
                  },
                  "metadata": {
                    "type": "object",
                    "maxProperties": 32
                  },
                  "source_participant_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "id",
                  "direction",
                  "media_kind",
                  "janus_mid",
                  "janus_feed_id",
                  "janus_feed_mid",
                  "is_active",
                  "is_ready",
                  "is_moderated",
                  "metadata"
                ],
                "additionalProperties": false
              },
              "minItems": 0,
              "maxItems": 256
            },
            "selected_streams": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "mid": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 0,
                        "maxLength": 128
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "feed": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[1-9][0-9]*$",
                        "maxLength": 128
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "crossrefid": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 0,
                        "maxLength": 128
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "sub_mid": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 0,
                        "maxLength": 128
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "mid",
                  "feed",
                  "crossrefid",
                  "sub_mid"
                ],
                "additionalProperties": false
              },
              "minItems": 0,
              "maxItems": 256
            },
            "negotiation_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            }
          },
          "required": [
            "action",
            "participant_id",
            "handle_type",
            "lifecycle_state",
            "streams",
            "selected_streams"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "participant_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            "scopes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "lobby",
                  "media:publish",
                  "media:subscribe",
                  "session:resume"
                ]
              }
            },
            "authorization_epoch": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "gateway_owner_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            "gateway_generation": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "participant_id",
            "scopes",
            "authorization_epoch",
            "gateway_owner_id",
            "gateway_generation"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        }
      ]
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "INVALID_MESSAGE",
            "UNSUPPORTED_VERSION",
            "UNAUTHENTICATED",
            "FORBIDDEN",
            "EXPIRED_TICKET",
            "REPLAYED_TICKET",
            "STALE_GENERATION",
            "STALE_AUTHORIZATION",
            "STALE_NEGOTIATION",
            "OUT_OF_ORDER",
            "RATE_LIMITED",
            "OVERLOADED",
            "UNAVAILABLE",
            "TIMEOUT",
            "OUTCOME_UNKNOWN",
            "NOT_IMPLEMENTED"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "id",
    "ok",
    "generation",
    "server_time"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "ok": {
          "const": true
        }
      },
      "required": [
        "result"
      ],
      "not": {
        "required": [
          "error"
        ]
      }
    },
    {
      "properties": {
        "ok": {
          "const": false
        }
      },
      "required": [
        "error"
      ],
      "not": {
        "required": [
          "result"
        ]
      }
    }
  ]
}
