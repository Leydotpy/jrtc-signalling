{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jrtc-signalling:v1:state-notification",
  "title": "state-notification",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "type": {
      "const": "state.changed"
    },
    "meeting_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "projection_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "previous_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "participant_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    },
    "context": {
      "enum": [
        "live",
        "replay",
        "snapshot"
      ]
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "type",
    "meeting_id",
    "projection_version",
    "previous_version",
    "participant_ids",
    "occurred_at",
    "context"
  ],
  "additionalProperties": false
}
